# test-packages.config
# ROCm Installer Build Configuration - Test Package Definitions
#
# This file is automatically included when building with the 'test' argument:
#   ./build-runfile-installer.sh config=nightly.config test
#
# It defines test packages for validation and functional testing.
# These packages are added to PULL_CONFIG_PKG_EXTRA when the 'test' flag is set.
#
# Usage:
#   Production build (no tests):  ./build-runfile-installer.sh config=nightly.config
#   Test build (with tests):      ./build-runfile-installer.sh config=nightly.config test

#==============================================================================
# TEST PACKAGES
#==============================================================================

# Extra packages (array) - Test packages for validation and functional testing
# Use base: prefix for packages without architecture suffix (e.g., base:amdrocm-decode-test)
#
# These packages include:
# - Library test suites (BLAS, DNN, FFT, Solver, Sparse, RAND)
# - Communication test suites (CCL, RCCL, ROCSHMEM)
# - Tool test suites (Debugger, Profiler, RDC)
# - Media test suites (Decode, JPEG)
# - Runtime test suites (Runtime, OpenCL)

PULL_CONFIG_PKG_EXTRA=(
    amdrocm-blas-test
    amdrocm-ccl-test
    base:amdrocm-debugger-test
    base:amdrocm-decode-test
    amdrocm-dnn-test
    amdrocm-fft-test
    base:amdrocm-jpeg-test
    amdrocm-rand-test
    base:amdrocm-runtime-test
    amdrocm-solver-test
    amdrocm-sparse-test
    base:amdrocm-opencl-test
    base:amdrocm-profiler-test
    base:amdrocm-rdc-test
    base:amdrocm-rocshmem-test
    amdrocm-rccl-test
)

# Note: When 'test' argument is provided, these packages are merged with
# any existing PULL_CONFIG_PKG_EXTRA from the main configuration file.
