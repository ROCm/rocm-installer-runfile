# nightly-singlearch.config
# ROCm Installer Build Configuration - Nightly Single-Arch Builds
#
# This preset is configured for nightly builds with all GPU architectures.
# Command-line arguments will override these settings.
#
# Build URL: https://rocm.nightlies.amd.com
#
# Equivalent command line:
#   ./build-runfile-installer.sh \
#       pull=nightly-singlearch pulltag=20260521 pullrunid=26203389112 pullrocmver=7.14.0 \
#       pullamdgpu=release,31.30 \
#       pullpkgextra=amdrocm-blas-test,amdrocm-ccl-test,base:amdrocm-debugger-test,base:amdrocm-decode-test,amdrocm-dnn-test,amdrocm-fft-test,base:amdrocm-jpeg-test,amdrocm-rand-test,base:amdrocm-runtime-test,amdrocm-solver-test,amdrocm-sparse-test \
#       rocm-archs=gfx908,gfx90a,gfx94x,gfx950,gfx103x,gfx110x,gfx115x,gfx120x \
#       amdgpu-mode=all rocm-mode=chroot \
#       mscomp=hybrid buildname=20260521-26203389112 buildrunid=26203389112 buildworkflow=1

#==============================================================================
# SETUP CONFIGURATION (setup-installer.sh)
#==============================================================================

# Release type: dev, nightly, nightly-singlearch, prerelease, release
# Arg: pull=<type>
PULL_CONFIG_RELEASE_TYPE="nightly-singlearch"

# Build tag (required for all builds)
# Arg: pulltag=<tag>
# IMPORTANT: Update this to current date (YYYYMMDD) before use
PULL_CONFIG_TAG="20260521"

# Component build run ID (required for all builds)
# Arg: pullrunid=<runid>
# IMPORTANT: Update this to actual run ID from nightly build
PULL_CONFIG_RUNID="26203389112"

# ROCm version (e.g., 7.12.0, 7.13.0, 7.14.0)
# Arg: pullrocmver=<version>
PULL_CONFIG_ROCM_VER="7.14.0"

# Base package to pull (default: amdrocm-core-sdk)
# Arg: pullpkg=<package>
PULL_CONFIG_PKG="amdrocm-core-sdk"

# Extra packages (array) - comma-separated via pullpkgextra=<packages>
# Arg: pullpkgextra=<pkg1,pkg2,pkg3>
# Test packages for validation and functional testing
# Use base: prefix for packages without architecture suffix (e.g., base:amdrocm-decode-test)
PULL_CONFIG_PKG_EXTRA=(amdrocm-blas-test amdrocm-ccl-test base:amdrocm-debugger-test base:amdrocm-decode-test amdrocm-dnn-test amdrocm-fft-test base:amdrocm-jpeg-test amdrocm-rand-test base:amdrocm-runtime-test amdrocm-solver-test amdrocm-sparse-test)

# GPU architectures to include (array) - comma-separated via rocm-archs=<archs>
# Arg: rocm-archs=<arch1,arch2,arch3>
# Single-arch builds use coarse families (gfx110x, gfx94x, etc.)
ROCM_GFX_ARCHS=(gfx908 gfx90a gfx94x gfx950 gfx103x gfx110x gfx1150 gfx1151 gfx1152 gfx120x)

# AMDGPU configuration type and version
# Arg: pullamdgpu=<type>
PULL_CONFIG_AMDGPU="release"

# AMDGPU version (for release) or build number (for custom config)
# Arg: pullamdgpuver=<version|buildnum>
PULL_CONFIG_AMDGPU_BUILDNUM="31.30"

# Graphics version (Mesa/amdgpu-lib packages for graphics use case)
# Arg: pullgraphicsver=<version>
PULL_CONFIG_GRAPHICS_VER="26.12"

# AMDGPU mode: all (all distros) or single (current distro)
# Arg: amdgpu-mode=<all|single>
SETUP_AMDGPU_MODE="all"

# ROCm mode: native (use current OS) or chroot (use Ubuntu chroot)
# Arg: rocm-mode=<native|chroot>
SETUP_ROCM_MODE="chroot"

# Setup control flags (set via 'rocm' or 'amdgpu' args)
# Args: rocm, amdgpu
# Leave at 0 - script will auto-enable both if neither specified
SETUP_ROCM=0
SETUP_AMDGPU=0

#==============================================================================
# BUILD CONFIGURATION (build-installer.sh)
#==============================================================================

# Compression mode: hybrid, hybriddev, dev, normal, nocomp
# Arg: mscomp=<mode>
MAKESELF_COMPRESS_MODE="hybrid"

# Build name (used in installer name)
# Arg: buildname=<name>
# Note: Typically PULL_CONFIG_TAG-PULL_CONFIG_RUNID for nightly builds
BUILD_NAME="20260521-26203389112"

# Build run ID
# Arg: buildrunid=<id>
BUILD_RUNID="26203389112"

# Build workflow number
# Arg: buildworkflow=<num>
BUILD_WORKFLOW_NUM="1"

# Enable/disable features
# Args: noextract, norocm, noamdgpu, norunfile, nogui
BUILD_EXTRACT="yes"      # Set to "no" via: noextract
BUILD_INSTALLER="yes"    # Set to "no" via: norunfile
BUILD_UI="yes"           # Set to "no" via: nogui
EXTRACT_ROCM="yes"       # Set to "no" via: norocm
EXTRACT_AMDGPU="yes"     # Set to "no" via: noamdgpu

# Extract type (optional)
# Args: noextractcontent, contentlist
EXTRACT_TYPE=""          # Set to "nocontent" via: noextractcontent
                         # Set to "contentlist" via: contentlist
